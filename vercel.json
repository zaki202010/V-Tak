{
  "version": 2,
  "outputDirectory": "public",
  "functions": {
    "api/index.php": { "runtime": "vercel-php@0.9.0" }
  },
  "routes": [
    {
      "src": "/_next/static/(.*)",
      "dest": "/public/_next/static/$1"
    },
    {
      "src": "/(.*).(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)",
      "dest": "/public/$1.$2"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.php"
    }
  ]
}
